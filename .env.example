# CLOUDFLARE_ACCOUNT_ID: Your Cloudflare Account ID (found in Cloudflare Dashboard > Workers & Pages).
# Free tier includes 10,000 Workers AI Neurons per day (resets daily at 00:00 UTC).
# Configure via Settings > Secrets in AI Studio (never expose in frontend code).
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"

# CLOUDFLARE_API_TOKEN: Cloudflare API Token with Workers AI Read/Run permission.
# Configure via Settings > Secrets in AI Studio (never expose in frontend code).
CLOUDFLARE_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
